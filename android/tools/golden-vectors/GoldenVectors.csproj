<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test tool for the Android port. It compiles the desktop protocol sources; see README.md here.
    "vectors" writes reference outputs the Kotlin tests compare against,
    "phone PORT KEY.pk8" plays a minimal iPhone over TCP for an interop run.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Iap2Loc</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Protocol/*.cs" />
    <Compile Include="../../../Transport/ITransport.cs" />
    <Compile Include="../../../Transport/TcpTransport.cs" />
    <Compile Include="../../../Cli.cs" />
  </ItemGroup>

</Project>
